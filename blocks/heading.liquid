{%- liquid
  assign tag = block.settings.heading_tag
  assign preset = block.settings.type_preset
  assign alignment = block.settings.alignment
  assign color = block.settings.color
  assign has_bg = block.settings.background
  assign bg_color = block.settings.background_color
  assign radius = block.settings.corner_radius
  assign pt = block.settings.padding_top
  assign pb = block.settings.padding_bottom
  assign pl = block.settings.padding_left
  assign pr = block.settings.padding_right
-%}

{%- style -%}
  #block-{{ block.id }} {
    /* ── Alignment ── */
    text-align: {{ alignment }};
    {%- if alignment == 'center' -%}
      margin-inline: auto;
    {%- elsif alignment == 'right' -%}
      margin-inline-start: auto;
    {%- endif -%}

    /* ── Typography Presets ── */
    {%- if preset == 'h1' -%}
      font-size: clamp(2.5rem, 5vw, 4rem);
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: -0.02em;
    {%- elsif preset == 'h2' -%}
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 700;
      line-height: 1.15;
      letter-spacing: -0.01em;
    {%- elsif preset == 'h3' -%}
      font-size: clamp(1.5rem, 3vw, 2.25rem);
      font-weight: 600;
      line-height: 1.2;
    {%- elsif preset == 'h4' -%}
      font-size: clamp(1.25rem, 2.5vw, 1.75rem);
      font-weight: 600;
      line-height: 1.25;
    {%- elsif preset == 'h5' -%}
      font-size: clamp(1rem, 2vw, 1.375rem);
      font-weight: 600;
      line-height: 1.3;
    {%- elsif preset == 'h6' -%}
      font-size: clamp(0.875rem, 1.5vw, 1.125rem);
      font-weight: 600;
      line-height: 1.35;
      letter-spacing: 0.02em;
    {%- elsif preset == 'custom' -%}
      font-size: {{ block.settings.font_size }}px;
      font-weight: {{ block.settings.font_weight }};
      line-height: {{ block.settings.line_height | divided_by: 10.0 }};
      letter-spacing: {{ block.settings.letter_spacing | divided_by: 100.0 }}em;
    {%- endif -%}

    /* ── Text Case & Wrap ── */
    {%- unless block.settings.text_case == 'none' -%}
      text-transform: {{ block.settings.text_case }};
    {%- endunless -%}
    text-wrap: {{ block.settings.text_wrap }};

    /* ── Color ── */
    color: {{ color }};

    /* ── Background ── */
    {%- if has_bg -%}
      background-color: {{ bg_color }};
      padding: {{ pt }}px {{ pr }}px {{ pb }}px {{ pl }}px;
      border-radius: {{ radius }}px;
      display: inline-block;
      {%- if alignment == 'center' -%}
        margin-left: auto;
        margin-right: auto;
        display: block;
      {%- endif -%}
    {%- else -%}
      padding: {{ pt }}px {{ pr }}px {{ pb }}px {{ pl }}px;
    {%- endif -%}

    box-sizing: border-box;
    display: block;
    margin: 0;
  }
{%- endstyle -%}

<{{ tag }}
  id="block-{{ block.id }}"
  {{ block.shopify_attributes }}
>
  {{ block.settings.text }}
</{{ tag }}>

{% schema %}
{
  "name": "Heading",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Timeless Design for Modern Living</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "← Left" },
        { "value": "center", "label": "↔ Center" },
        { "value": "right", "label": "→ Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "HTML Tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "type_preset",
      "label": "Typography Preset",
      "options": [
        { "value": "h1", "label": "H1 — Display (2.5-4rem)" },
        { "value": "h2", "label": "H2 — Heading (2-3rem)" },
        { "value": "h3", "label": "H3 — Subheading (1.5-2.25rem)" },
        { "value": "h4", "label": "H4 — Section Title (1.25-1.75rem)" },
        { "value": "h5", "label": "H5 — Small Heading (1-1.375rem)" },
        { "value": "h6", "label": "H6 — Label (0.875-1.125rem)" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font Size",
      "min": 12,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ block.settings.type_preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font Weight",
      "options": [
        { "value": "300", "label": "Light (300)" },
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi Bold (600)" },
        { "value": "700", "label": "Bold (700)" },
        { "value": "800", "label": "Extra Bold (800)" },
        { "value": "900", "label": "Black (900)" }
      ],
      "default": "700",
      "visible_if": "{{ block.settings.type_preset == 'custom' }}"
    },
    {
      "type": "range",
      "id": "line_height",
      "label": "Line Height",
      "min": 8,
      "max": 30,
      "step": 1,
      "default": 12,
      "info": "Value ÷ 10 = actual (e.g. 12 → 1.2)",
      "visible_if": "{{ block.settings.type_preset == 'custom' }}"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter Spacing",
      "min": -30,
      "max": 30,
      "step": 1,
      "default": 0,
      "info": "Value ÷ 100 = em (e.g. -2 → -0.02em)",
      "visible_if": "{{ block.settings.type_preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "text_case",
      "label": "Case",
      "options": [
        { "value": "none", "label": "Default" },
        { "value": "uppercase", "label": "UPPERCASE" },
        { "value": "lowercase", "label": "lowercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "text_wrap",
      "label": "Text Wrap",
      "options": [
        { "value": "wrap", "label": "Wrap" },
        { "value": "balance", "label": "Balance" },
        { "value": "pretty", "label": "Pretty" },
        { "value": "nowrap", "label": "No Wrap" }
      ],
      "default": "balance"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "checkbox",
      "id": "background",
      "label": "Enable Background Color",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f5f5f5",
      "visible_if": "{{ block.settings.background }}"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner Radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Left",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Right",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Heading",
      "settings": {
        "text": "<p>Timeless Design for Modern Living</p>",
        "heading_tag": "h2",
        "type_preset": "h2",
        "alignment": "left"
      }
    },
    {
      "name": "Display Heading",
      "settings": {
        "text": "<p>Bold. Beautiful. Unforgettable.</p>",
        "heading_tag": "h1",
        "type_preset": "h1",
        "alignment": "center",
        "text_wrap": "balance"
      }
    },
    {
      "name": "Section Label",
      "settings": {
        "text": "<p>Our Collection</p>",
        "heading_tag": "h6",
        "type_preset": "h6",
        "text_case": "uppercase",
        "alignment": "left"
      }
    }
  ]
}
{% endschema %}
