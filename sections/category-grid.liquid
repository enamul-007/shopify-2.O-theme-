{%- style -%}
  #shopify-section-{{ section.id }} .category-section {
    padding: {{ section.settings.padding_v_mobile }}px 0;
    background-color: {{ section.settings.color_scheme.settings.background }};
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .category-section { 
      padding: {{ section.settings.padding_v_desktop }}px 0; 
    }
  }
  #shopify-section-{{ section.id }} .category-inner { 
    max-width: 1400px; 
    margin: 0 auto; 
    padding: 0 1.5rem; 
  }
  #shopify-section-{{ section.id }} .category-header {
    text-align: {{ section.settings.header_alignment }};
    margin-bottom: {{ section.settings.header_margin_bottom }}px;
  }
  #shopify-section-{{ section.id }} .category-grid {
    display: grid; 
    grid-template-columns: repeat(2, 1fr); 
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .category-grid { 
      grid-template-columns: repeat(3, 1fr); 
    }
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .category-grid { 
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr); 
    }
  }
{%- endstyle -%}

<section class="category-section" id="CategorySection-{{ section.id }}">
  <div class="category-inner">
    {%- if section.settings.title != blank -%}
      <div class="category-header">
        <h2 class="category-title" style="color: {{ section.settings.title_color }};">{{ section.settings.title }}</h2>
      </div>
    {%- endif -%}

    <div class="category-grid">
      {%- content_for 'blocks' -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category Grid",
  "tag": "section",
  "class": "section-category-grid",
  "blocks": [
    {
      "type": "category-card"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Section Layout"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color Scheme", "default": "scheme-1" },
    { 
      "type": "range", 
      "id": "padding_v_mobile", 
      "label": "Padding Mobile", 
      "min": 0, 
      "max": 100, 
      "step": 2, 
      "unit": "px", 
      "default": 40 
    },
    { 
      "type": "range", 
      "id": "padding_v_desktop", 
      "label": "Padding Desktop", 
      "min": 0, 
      "max": 200, 
      "step": 2, 
      "unit": "px", 
      "default": 80 
    },
    {
      "type": "header",
      "content": "Section Header"
    },
    { "type": "text", "id": "title", "label": "Title", "default": "Featured Categories" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#121212" },
    { 
      "type": "select", 
      "id": "header_alignment", 
      "label": "Header Alignment", 
      "options": [
        {"value":"left","label":"Left"},
        {"value":"center","label":"Center"},
        {"value":"right","label":"Right"}
      ], 
      "default": "center" 
    },
    { "type": "range", "id": "header_margin_bottom", "label": "Header Bottom Spacing", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    {
      "type": "header",
      "content": "Grid Settings"
    },
    { 
      "type": "select", 
      "id": "columns_desktop", 
      "label": "Columns Desktop", 
      "options": [
        {"value":"3","label":"3"},
        {"value":"4","label":"4"},
        {"value":"5","label":"5"},
        {"value":"6","label":"6"}
      ], 
      "default": "6" 
    }
  ],
  "presets": [
    {
      "name": "Category Grid",
      "blocks": [
        { 
          "type": "category-card",
          "blocks": [
            { "type": "category-image" },
            { "type": "category-title" }
          ]
        },
        { 
          "type": "category-card",
          "blocks": [
            { "type": "category-image" },
            { "type": "category-title" }
          ]
        },
        { 
          "type": "category-card",
          "blocks": [
            { "type": "category-image" },
            { "type": "category-title" }
          ]
        },
        { 
          "type": "category-card",
          "blocks": [
            { "type": "category-image" },
            { "type": "category-title" }
          ]
        }
      ]
    }
  ]
}
{% endschema %}